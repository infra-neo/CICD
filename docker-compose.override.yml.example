# Docker Compose Override Example
# 
# This file demonstrates how to override default settings for production use.
# Copy this to docker-compose.override.yml and customize as needed.
#
# Docker Compose automatically merges docker-compose.yml with 
# docker-compose.override.yml if it exists.

version: '3.8'

services:
  jenkins:
    # Use specific version for production
    # image: jenkins/jenkins:2.414.3-lts
    
    # Increase memory limits
    environment:
      - JAVA_OPTS=-Djenkins.install.runSetupWizard=false -Xmx4096m -Xms2048m
    
    # Add resource constraints
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G
    
    # Add health check
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8080 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s
    
    # Mount additional configurations
    # volumes:
    #   - ./jenkins-production.yml:/var/jenkins_home/jenkins.yaml
    #   - /etc/ssl/certs:/etc/ssl/certs:ro

  postgres:
    # Use specific PostgreSQL version
    # image: postgres:13.12
    
    # Production database settings
    environment:
      - POSTGRES_USER=sonar_prod
      - POSTGRES_PASSWORD=${DB_PASSWORD:-changeme}
      - POSTGRES_DB=sonarqube_prod
    
    # Add resource limits
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
    
    # Mount custom PostgreSQL config
    # volumes:
    #   - ./postgres/postgresql.conf:/etc/postgresql/postgresql.conf:ro
    
    command: 
      - postgres
      - -c
      - max_connections=300
      - -c
      - shared_buffers=256MB

  sonarqube:
    # Use specific SonarQube version
    # image: sonarqube:9.9.2-community
    
    # Production environment settings
    environment:
      - SONAR_JDBC_URL=jdbc:postgresql://postgres:5432/sonarqube_prod
      - SONAR_JDBC_USERNAME=sonar_prod
      - SONAR_JDBC_PASSWORD=${DB_PASSWORD:-changeme}
      - SONAR_WEB_JAVAOPTS=-Xmx2048m -Xms1024m
      - SONAR_CE_JAVAOPTS=-Xmx2048m -Xms1024m
    
    # Add resource constraints
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G
    
    # Health check
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:9000/api/system/status || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 180s

  nexus:
    # Use specific Nexus version
    # image: sonatype/nexus3:3.60.0
    
    # Production JVM settings
    environment:
      - INSTALL4J_ADD_VM_PARAMS=-Xms2048m -Xmx2048m -XX:MaxDirectMemorySize=2048m
      - NEXUS_CONTEXT=${NEXUS_CONTEXT:-/}
    
    # Add resource constraints
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 4G
        reservations:
          cpus: '1.0'
          memory: 2G
    
    # Health check
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8081/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 300s

# Production network configuration
networks:
  cicd-network:
    driver: bridge
    ipam:
      driver: default
      config:
        - subnet: 172.28.0.0/16

# Production volume configuration with named volumes
volumes:
  jenkins_home:
    driver: local
    driver_opts:
      type: none
      device: /var/lib/jenkins_home  # Use actual path
      o: bind
  
  postgres_data:
    driver: local
    driver_opts:
      type: none
      device: /var/lib/postgresql/data  # Use actual path
      o: bind
  
  sonarqube_data:
    driver: local
  
  sonarqube_extensions:
    driver: local
  
  sonarqube_logs:
    driver: local
  
  nexus_data:
    driver: local
    driver_opts:
      type: none
      device: /var/lib/nexus-data  # Use actual path
      o: bind
