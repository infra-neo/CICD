# Secrets Configuration Template
# DO NOT commit this file with real passwords!
# Copy to .env and add real values

# Database Passwords
DB_PASSWORD_DEV=devpass123
DB_PASSWORD_STAGING=stagingpass123
DB_PASSWORD_PROD=prodpass123

# Nexus Credentials
NEXUS_USER=admin
NEXUS_PASSWORD=admin123

# SonarQube Credentials
SONAR_TOKEN=admin

# WildFly/JBoss Credentials
WILDFLY_USER=admin
WILDFLY_PASS=admin
JBOSS_USER=admin
JBOSS_PASS=admin

# Application Versioning
APP_VERSION=1.0.0-SNAPSHOT

# Jenkins Credentials
JENKINS_USER=admin
JENKINS_PASS=admin
